{
  "format": "evn-blocks",
  "version": 2,
  "title": "7-segment display: minimal",
  "needs": "the 7-segment display on I2C port 1",
  "description": "The 7-segment display counts down from 10 to 0, then says DONE.",
  "workspace": {
    "blocks": {
      "languageVersion": 0,
      "blocks": [
        {
          "type": "evn_setup_start",
          "x": 30,
          "y": 30,
          "next": {
            "block": {
              "type": "evn_seven_setup",
              "fields": {
                "PORT": "1"
              }
            }
          }
        },
        {
          "type": "evn_program_start",
          "x": 30,
          "y": 115,
          "next": {
            "block": {
              "type": "controls_for",
              "fields": {
                "VAR": {
                  "id": "v_i"
                }
              },
              "inputs": {
                "FROM": {
                  "shadow": {
                    "type": "math_number",
                    "fields": {
                      "NUM": 10
                    }
                  }
                },
                "TO": {
                  "shadow": {
                    "type": "math_number",
                    "fields": {
                      "NUM": 0
                    }
                  }
                },
                "BY": {
                  "shadow": {
                    "type": "math_number",
                    "fields": {
                      "NUM": 1
                    }
                  }
                },
                "DO": {
                  "block": {
                    "type": "evn_seven_number",
                    "fields": {
                      "PORT": "1"
                    },
                    "inputs": {
                      "NUMBER": {
                        "block": {
                          "type": "variables_get",
                          "fields": {
                            "VAR": {
                              "id": "v_i"
                            }
                          }
                        }
                      }
                    },
                    "next": {
                      "block": {
                        "type": "evn_wait",
                        "inputs": {
                          "TIME": {
                            "shadow": {
                              "type": "math_number",
                              "fields": {
                                "NUM": 500
                              }
                            }
                          }
                        }
                      }
                    }
                  }
                }
              },
              "next": {
                "block": {
                  "type": "evn_seven_text",
                  "fields": {
                    "PORT": "1"
                  },
                  "inputs": {
                    "TEXT": {
                      "shadow": {
                        "type": "text",
                        "fields": {
                          "TEXT": "DONE"
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      ]
    },
    "variables": [
      {
        "name": "i",
        "id": "v_i"
      }
    ]
  }
}
