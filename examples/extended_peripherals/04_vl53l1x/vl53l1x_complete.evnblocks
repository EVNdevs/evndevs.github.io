{
  "format": "evn-blocks",
  "version": 2,
  "title": "VL53L1X distance sensor: every block",
  "needs": "an ST VL53L1X distance sensor on I2C port 1",
  "description": "Every block of the VL53L1X: ten seconds of distances in short range (up to about 1.3 m, better in daylight), then ten seconds in long range (up to about 4 m in the dark); -1 when a reading is not valid.",
  "workspace": {
    "blocks": {
      "languageVersion": 0,
      "blocks": [
        {
          "type": "evn_setup_start",
          "x": 30,
          "y": 30,
          "next": {
            "block": {
              "type": "evn_vl53l1x_setup",
              "fields": {
                "PORT": "1"
              }
            }
          }
        },
        {
          "type": "evn_program_start",
          "x": 30,
          "y": 160,
          "next": {
            "block": {
              "type": "evn_vl53l1x_mode",
              "fields": {
                "PORT": "1",
                "MODE": "short"
              },
              "next": {
                "block": {
                  "type": "controls_repeat_ext",
                  "inputs": {
                    "TIMES": {
                      "shadow": {
                        "type": "math_number",
                        "fields": {
                          "NUM": 20
                        }
                      }
                    },
                    "DO": {
                      "block": {
                        "type": "text_print",
                        "inputs": {
                          "TEXT": {
                            "block": {
                              "type": "evn_vl53l1x_distance",
                              "fields": {
                                "PORT": "1"
                              }
                            }
                          }
                        },
                        "next": {
                          "block": {
                            "type": "evn_wait",
                            "inputs": {
                              "TIME": {
                                "shadow": {
                                  "type": "math_number",
                                  "fields": {
                                    "NUM": 500
                                  }
                                }
                              }
                            }
                          }
                        }
                      }
                    }
                  },
                  "next": {
                    "block": {
                      "type": "evn_vl53l1x_mode",
                      "fields": {
                        "PORT": "1",
                        "MODE": "long"
                      },
                      "next": {
                        "block": {
                          "type": "controls_repeat_ext",
                          "inputs": {
                            "TIMES": {
                              "shadow": {
                                "type": "math_number",
                                "fields": {
                                  "NUM": 20
                                }
                              }
                            },
                            "DO": {
                              "block": {
                                "type": "text_print",
                                "inputs": {
                                  "TEXT": {
                                    "block": {
                                      "type": "evn_vl53l1x_distance",
                                      "fields": {
                                        "PORT": "1"
                                      }
                                    }
                                  }
                                },
                                "next": {
                                  "block": {
                                    "type": "evn_wait",
                                    "inputs": {
                                      "TIME": {
                                        "shadow": {
                                          "type": "math_number",
                                          "fields": {
                                            "NUM": 500
                                          }
                                        }
                                      }
                                    }
                                  }
                                }
                              }
                            }
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      ]
    }
  }
}
