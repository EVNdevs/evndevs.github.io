{
  "format": "evn-blocks",
  "version": 2,
  "title": "LED matrix: minimal",
  "needs": "the 8x8 LED matrix on I2C port 1",
  "description": "The LED matrix counts down from 5 to 0, then shows a heart.",
  "workspace": {
    "blocks": {
      "languageVersion": 0,
      "blocks": [
        {
          "type": "evn_setup_start",
          "x": 30,
          "y": 30,
          "next": {
            "block": {
              "type": "evn_matrix_setup",
              "fields": {
                "PORT": "1"
              }
            }
          }
        },
        {
          "type": "evn_program_start",
          "x": 30,
          "y": 115,
          "next": {
            "block": {
              "type": "controls_for",
              "fields": {
                "VAR": {
                  "id": "v_i"
                }
              },
              "inputs": {
                "FROM": {
                  "shadow": {
                    "type": "math_number",
                    "fields": {
                      "NUM": 5
                    }
                  }
                },
                "TO": {
                  "shadow": {
                    "type": "math_number",
                    "fields": {
                      "NUM": 0
                    }
                  }
                },
                "BY": {
                  "shadow": {
                    "type": "math_number",
                    "fields": {
                      "NUM": 1
                    }
                  }
                },
                "DO": {
                  "block": {
                    "type": "evn_matrix_number",
                    "fields": {
                      "PORT": "1"
                    },
                    "inputs": {
                      "NUMBER": {
                        "block": {
                          "type": "variables_get",
                          "fields": {
                            "VAR": {
                              "id": "v_i"
                            }
                          }
                        }
                      }
                    },
                    "next": {
                      "block": {
                        "type": "evn_wait",
                        "inputs": {
                          "TIME": {
                            "shadow": {
                              "type": "math_number",
                              "fields": {
                                "NUM": 1000
                              }
                            }
                          }
                        }
                      }
                    }
                  }
                }
              },
              "next": {
                "block": {
                  "type": "evn_matrix_icon",
                  "fields": {
                    "PORT": "1",
                    "ICON": "HEART"
                  }
                }
              }
            }
          }
        }
      ]
    },
    "variables": [
      {
        "name": "i",
        "id": "v_i"
      }
    ]
  }
}
