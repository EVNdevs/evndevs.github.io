                                                                                        "fields": {
                                                                                          "NUM": -50
                                                                                        }
                                                                                      }
                                                                                    }
                                                                                  },
                                                                                  "next": {
                                                                                    "block": {
                                                                                      "type": "evn_wait",
                                                                                      "inputs": {
                                                                                        "TIME": {
                                                                                          "shadow": {
                                                                                            "type": "math_number",
                                                                                            "fields": {
                                                                                              "NUM": 2000
                                                                                            }
                                                                                          }
                                                                                        }
                                                                                      },
                                                                                      "next": {
                                                                                        "block": {
