                                                                                    "fields": {
                                                                                      "NUM": 2000
                                                                                    }
                                                                                  }
                                                                                }
                                                                              },
                                                                              "next": {
                                                                                "block": {
                                                                                  "type": "evn_servo_duty",
                                                                                  "fields": {
