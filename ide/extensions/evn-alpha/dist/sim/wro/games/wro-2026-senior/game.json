        "match": {
          "roles": { "t": "kind:tile", "k": "@cells" },
          "score": "if(!held(t) & !damaged(t) & in(t, k, completely, contact) & flat(t, uprightTileDeg), if(t.colour == $pattern[k.index], 10, 5), if(!held(t) & !damaged(t) & in(t, k, meets, contact), 5, 0))",
          "labels": { "10": "Mosaic tile correctly placed in the mosaic frame", "5": "Mosaic tile incorrectly placed in the mosaic frame" } } },
      { "id": "cement", "mission": "3.3", "per": "o in kind:cement", "let": { "A": "@cement[o.colour]" },
        "tiers": [
          { "points": 1, "label": "Cement element is completely in its colour's cement target area", "when": "!held(o) & !damaged(o) & !in(o, @marking, meets, plan) & (in(o, A, completely, contact) | (!touchesMat(o) & len(supports*(o)) > 0)) & all(s in supports*(o): !held(s) & !in(s, @marking, meets, plan) & (in(s, A, completely, contact) | (!touchesMat(s) & len(supports*(s)) > 0)))" }
        ] },
      { "id": "barriers", "mission": "3.4", "per": "o in kind:barrier",
        "tiers": [
          { "points": 7, "label": "Barrier is not damaged or moved", "when": "!damaged(o) & !moved(o)" }
        ] }
    ]
  },
