  "rules": {
    "defaults": {
      "tol": { "value": 0.5, "tag": "READING", "ref": "OQ 66 (n), (p): the 0.5 mm in the team's favour, per edge, mitred" },
      "restMm": { "value": 1.0, "tag": "MODEL", "ref": "games.ts REST_MM; W3a rules S5" },
      "contactMm": { "value": 0.2, "tag": "MODEL", "ref": "SIMULATOR_ENGINE_DESIGN.md §3.5 P4" },
      "supportDeg": { "value": 60, "tag": "MODEL", "ref": "SIMULATOR_ENGINE_DESIGN.md §3.5 P4" },
      "uprightVisitorDeg": { "value": 0.8, "tag": "READING", "ref": "ES D232 (D65's form): asin(restMm / D), D 71.3 mm (the 63.8 x 31.8 base); OQ 73 (cn) (2) default" },
      "uprightArtefactDeg": { "value": 1.27, "tag": "READING", "ref": "ES D232 (D65's form): asin(restMm / D), D 45.0 mm (the 31.8 mm base); OQ 73 (cn) (2) default" },
      "uprightRedDeg": { "value": 0.85, "tag": "READING", "ref": "ES D232 (D65's form): asin(restMm / D), D 67.6 mm (the 47.8 mm base); the red line, named by the orchestrator beside OQ 73 (cn) (2)" }
    },
    "named": {},
    "missions": [
      { "id": "3.1", "label": "Show the visitors around", "max": 40, "task": true },
      { "id": "3.2", "label": "Rebuild the towers", "max": 80, "task": true },
      { "id": "3.3", "label": "Bring the artefacts in the museum", "max": 60, "task": true },
      { "id": "3.4", "label": "Clear the cobblestone of dirt", "max": 20, "task": true },
      { "id": "3.5", "label": "Bonus points", "max": 30, "task": false }
    ],
    "lines": [
      { "id": "visitors", "mission": "3.1", "per": "o in kind:visitor", "let": { "own": "@visitor_target[o.colour]" },
        "tiers": [
          { "points": 10, "label": "Visitor completely in its colour's area and upright", "when": "(touchesMat(o) | onMat(o)) & !held(o) & in(o, own, completely, contact) & upright(o, uprightVisitorDeg)" },
          { "points": 5, "label": "Visitor partly in its colour's area, or not upright", "when": "(touchesMat(o) | onMat(o)) & !held(o) & ((in(o, own, completely, contact) & !upright(o, uprightVisitorDeg)) | in(o, own, partly, contact))" }
        ],
        "else": [ { "reason": "wrong colour", "when": "in(o, @visitor_target - own, meets, contact)" } ] },
      { "id": "red", "mission": "3.2",
        "match": {
          "roles": { "o": "kind:red_tower", "a": "@red_target" },
          "score": "if((touchesMat(o) | onMat(o)) & !held(o) & in(o, a, meets, contact) & upright(o, uprightRedDeg), if(in(o, a, completely, contact), 15, if(in(o, a, partly, contact), 10, 0)), 0)",
          "labels": { "15": "Red tower completely in a red target and upright", "10": "Red tower partly in a red target and upright" } } },
      { "id": "yellow", "mission": "3.2",
        "match": {
          "roles": { "t": "kind:yellow_tower_top", "b": "kind:yellow_tower_base" },
          "score": "if(!onMat(t) & restsOn(t, b) & onMat(b) & in(t.origin, b.pad) & upright(t) & in(b, @yellow_target, meets) & upright(b), if(in(b, @yellow_target, completely), 25, if(in(b, @yellow_target, partly), 15, 0)), 0)",
          "targetReason": "onMat(b) & in(b, @yellow_target, meets) & upright(b) & (in(b, @yellow_target, completely) | in(b, @yellow_target, partly))",
          "labels": { "25": "Yellow top correctly on a base, the base completely in a yellow target", "15": "Yellow top correctly on a base, the base partly in a yellow target" } },
        "else": [
          { "reason": "wrong base", "when": "!onMat(t) & restsOn(t, kind:visitor | kind:red_tower | kind:yellow_tower_top | kind:artefact | kind:dirt | kind:barrier | kind:parrot)" },
          { "reason": "wrong base", "when": "!onMat(t) & any(x in kind:yellow_tower_base: restsOn(t, x) & any(u in kind:yellow_tower_top: u.index < t.index & !onMat(u) & restsOn(u, x) & onMat(x) & in(u.origin, x.pad) & upright(u)))" }
        ] },
      { "id": "artefacts", "mission": "3.3", "per": "o in kind:artefact", "let": { "own": "@exhibition[o.colour]" },
        "tiers": [
          { "points": 15, "label": "Artefact completely in its colour's exhibition spot and upright", "when": "(touchesMat(o) | onMat(o)) & !held(o) & in(o, own, completely, contact) & upright(o, uprightArtefactDeg)" },
          { "points": 5, "label": "Artefact partly in its colour's exhibition spot, or not upright", "when": "(touchesMat(o) | onMat(o)) & !held(o) & ((in(o, own, completely, contact) & !upright(o, uprightArtefactDeg)) | in(o, own, partly, contact))" }
        ],
        "else": [ { "reason": "wrong colour", "when": "in(o, @exhibition - own, meets, contact)" } ] },
      { "id": "dirt", "mission": "3.4", "per": "o in kind:dirt",
        "tiers": [ { "points": 2, "label": "Dirt particle not touching the cobblestone area", "when": "!((touchesMat(o) | onMat(o)) & in(o, @cobblestone, meets, contact))" } ] },
      { "id": "barriers", "mission": "3.5", "per": "o in kind:barrier | kind:parrot",
        "tiers": [ { "points": 10, "label": "Barrier or parrot not moved or damaged", "when": "!damaged(o) & !moved(o)" } ] }
    ]
  },
  "examples": []
}
