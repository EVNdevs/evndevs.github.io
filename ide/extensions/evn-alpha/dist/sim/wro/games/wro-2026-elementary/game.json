    "settle": { "mms": 1, "dps": 1, "s": 0.25, "maxS": 2, "tag": "MODEL" }
  },
  "rules": {
    "defaults": {
      "tol": { "value": 0.5, "tag": "READING", "ref": "OQ 66 (n), (p) carried (OQ 70 (a)): the 0.5 mm in the team's favour, per edge, mitred" },
      "restMm": { "value": 1.0, "tag": "MODEL", "ref": "games.ts REST_MM; W3a rules S5" },
      "contactMm": { "value": 0.2, "tag": "MODEL", "ref": "SIMULATOR_ENGINE_DESIGN.md §3.5 P4" },
      "supportDeg": { "value": 60, "tag": "MODEL", "ref": "SIMULATOR_ENGINE_DESIGN.md §3.5 P4" },
      "uprightMicDeg": { "value": 1.0, "tag": "READING", "ref": "D65: asin(restMm / D), D 57.5 mm (the 47.8 x 31.9 mark); WRO's Q&A 2026-06-30" },
      "uprightNoteDeg": { "value": 1.27, "tag": "READING", "ref": "D65: asin(restMm / D), D 45.0 mm (the 31.8 mm base); OQ 73 (cn) (3) default" },
      "uprightCableDeg": { "value": 0.49, "tag": "READING", "ref": "D65: asin(restMm / D), D 116.1 mm (the base that tilts on the mat: its two feet, 111.6 x 31.9, D68); OQ 73 (cn) (3) default" },
      "uprightBonusDeg": { "value": 0.54, "tag": "READING", "ref": "D65: the least of the bonus classes' bounds (the amplifier, D 106.9 mm); OQ 73 (cn) (3) default" }
    },
    "named": {},
    "missions": [
      { "id": "3.1", "label": "Connect the amplifier with the speakers", "max": 30, "task": true },
      { "id": "3.2", "label": "Prepare the show", "max": 65, "task": true },
      { "id": "3.3", "label": "Play the song", "max": 120, "task": true },
      { "id": "3.4", "label": "Bonus points", "max": 40, "task": false }
    ],
    "lines": [
      { "id": "cables", "mission": "3.1",
        "match": {
          "roles": { "c": "kind:cable", "a": "@cable_areas" },
          "score": "if(!held(c) & !damaged(c) & in(c, a, completely, contact) & upright(c, uprightCableDeg), 15, if(!held(c) & !damaged(c) & in(c, a, meets, contact), 5, 0))",
          "labels": { "15": "Cable completely in a grey area and upright", "5": "Cable only partly in a grey area or not upright" } } },
      { "id": "microphone", "mission": "3.2", "per": "o in kind:microphone",
        "tiers": [
          { "points": 20, "label": "Microphone completely in its target area and upright", "when": "!held(o) & !damaged(o) & in(o, @mic_target, completely, contact) & upright(o, uprightMicDeg)" },
          { "points": 10, "label": "Microphone only partly in its target area or not upright", "when": "!held(o) & !damaged(o) & ((in(o, @mic_target, completely, contact) & !upright(o, uprightMicDeg)) | in(o, @mic_target, partly, contact))" }
        ] },
      { "id": "instruments", "mission": "3.2", "per": "o in kind:instrument",
        "tiers": [
          { "points": 15, "label": "Instrument completely in backstage", "when": "!held(o) & !damaged(o) & in(o, @backstage, completely, contact)" }
        ] },
      { "id": "notes", "mission": "3.3", "per": "o in kind:note", "let": { "own": "@note_target[o.colour]" },
        "tiers": [
          { "points": 20, "label": "Note completely in its colour's target (including grey border) and upright", "when": "!held(o) & !damaged(o) & in(o, own, completely, contact) & upright(o, uprightNoteDeg)" },
          { "points": 10, "label": "Note partly in its colour's target (including grey border) or not upright", "when": "!held(o) & !damaged(o) & ((in(o, own, completely, contact) & !upright(o, uprightNoteDeg)) | in(o, own, partly, contact))" }
        ],
        "else": [ { "reason": "wrong colour", "when": "in(o, @note_target - own, meets, contact)" } ] },
      { "id": "bonus", "mission": "3.4", "per": "o in kind:clef | kind:speaker | kind:amplifier",
        "tiers": [
          { "points": 10, "label": "Not damaged or moved", "when": "!held(o) & !damaged(o) & !moved(o) & upright(o, uprightBonusDeg)" }
        ] }
    ]
  },
