{
  "format": "evn-blocks",
  "version": 2,
  "title": "Board: every block",
  "needs": "nothing but the board; you press the user button when it asks",
  "description": "Every board and timing block once: the battery, the user button, the LED, waiting and the stopwatch. After the tour the LED follows the button until 20 s have gone by, then the program waits forever: press Stop to end it.",
  "workspace": {
    "blocks": {
      "languageVersion": 0,
      "blocks": [
        {
          "type": "evn_setup_start",
          "x": 30,
          "y": 30
        },
        {
          "type": "evn_program_start",
          "x": 30,
          "y": 115,
          "next": {
            "block": {
              "type": "evn_comment",
              "fields": {
                "TEXT": "the battery pack, in millivolts (0 without a pack)"
