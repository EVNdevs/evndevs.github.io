                                  "fields": {
                                    "PORT": "1",
                                    "WHAT": "angle"
                                  }
                                }
                              }
                            }
                          }
                        }
                      },
                      "next": {
                        "block": {
                          "type": "evn_wait",
                          "inputs": {
                            "TIME": {
                              "shadow": {
                                "type": "math_number",
                                "fields": {
                                  "NUM": 500
                                }
                              }
                            }
                          },
                          "next": {
                            "block": {
                              "type": "evn_motor_reset_angle",
                              "fields": {
                                "PORT": "1"
                              },
                              "inputs": {
