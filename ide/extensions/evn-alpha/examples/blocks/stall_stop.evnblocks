{
  "format": "evn-blocks",
  "version": 1,
  "needs": "a motor on port 1 and something to block its shaft (your hand or an end stop).",
  "workspace": {
    "blocks": {
      "languageVersion": 0,
      "blocks": [
        {
          "type": "text_print",
          "inputs": {
            "TEXT": {
              "shadow": {
                "type": "text",
                "fields": {
                  "TEXT": "grab the shaft within the next 3 s ..."
                }
              }
            }
          },
          "x": 20,
          "y": 20,
          "next": {
            "block": {
              "type": "evn_wait",
              "inputs": {
                "TIME": {
                  "shadow": {
                    "type": "math_number",
                    "fields": {
                      "NUM": 3000
                    }
                  }
                }
              },
              "next": {
                "block": {
                  "type": "evn_motor_run_until_stalled",
                  "fields": {
                    "PORT": "1",
                    "THEN": "COAST"
                  },
                  "inputs": {
