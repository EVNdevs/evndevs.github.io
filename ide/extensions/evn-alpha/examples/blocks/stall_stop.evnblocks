                                              }
                                            }
                                          }
                                        }
                                      },
                                      "next": {
                                        "block": {
                                          "type": "evn_motor_stop",
                                          "fields": {
                                            "ACTION": "stop",
                                            "PORT": "1"
                                          }
                                        }
                                      }
                                    }
                                  }
                                }
                              }
