                                                          "fields": {
                                                            "TEXT": "check for a swipe without waiting, for 10 s: each swipe is reported once, None in between"
                                                          },
                                                          "next": {
                                                            "block": {
                                                              "type": "controls_repeat_ext",
                                                              "inputs": {
                                                                "TIMES": {
                                                                  "shadow": {
                                                                    "type": "math_number",
                                                                    "fields": {
                                                                      "NUM": 200
                                                                    }
                                                                  }
