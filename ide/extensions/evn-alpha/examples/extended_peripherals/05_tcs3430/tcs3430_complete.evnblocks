{
  "format": "evn-blocks",
  "version": 2,
  "title": "TCS3430 colour sensor: every block",
  "needs": "an ams-OSRAM TCS3430 colour sensor on I2C port 16",
  "description": "Every block of the TCS3430: the black and the white taken first (nothing in front, then a white sheet: without them the module's warm LED makes white read yellow), the gain lowered to 16x (for a bright target close up), then for twenty seconds its colour, its X, Y, Z and infrared channels and its hue, and a message whenever it sees red. Last, the integration time set to 100 ms (the setting for room light or a target further away) and one brightness reading Y under it. Then a 50 ms wait between readings and the auto-zero every 10 readings, a Z window of 100 to 900 for 3 readings whose flag is printed after a second and cleared, one far-infrared reading (measured when asked), and the wait and the auto-zero back to their start-up values. The black and white calibration is stored for the port: later programs start with it.",
  "workspace": {
    "blocks": {
      "languageVersion": 0,
      "blocks": [
        {
          "type": "evn_setup_start",
          "x": 30,
          "y": 30,
          "next": {
            "block": {
              "type": "evn_tcs3430_setup",
              "fields": {
                "PORT": "16"
              }
            }
          }
        },
