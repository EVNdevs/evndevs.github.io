                                                                                  "inputs": {
                                                                                    "TIMES": {
                                                                                      "shadow": {
                                                                                        "type": "math_number",
                                                                                        "fields": {
                                                                                          "NUM": 30
                                                                                        }
                                                                                      }
                                                                                    },
                                                                                    "DO": {
                                                                                      "block": {
                                                                                        "type": "text_print",
                                                                                        "inputs": {
                                                                                          "TEXT": {
                                                                                            "block": {
                                                                                              "type": "evn_compass_heading",
                                                                                              "fields": {
                                                                                                "PORT": "2"
                                                                                              }
                                                                                            }
                                                                                          }
                                                                                        },
                                                                                        "next": {
                                                                                          "block": {
                                                                                            "type": "evn_wait",
                                                                                            "inputs": {
                                                                                              "TIME": {
                                                                                                "shadow": {
                                                                                                  "type": "math_number",
                                                                                                  "fields": {
                                                                                                    "NUM": 300
                                                                                                  }
                                                                                                }
                                                                                              }
                                                                                            }
                                                                                          }
                                                                                        }
                                                                                      }
                                                                                    }
                                                                                  }
                                                                                }
                                                                              }
                                                                            }
                                                                          }
                                                                        }
                                                                      }
                                                                    }
                                                                  }
                                                                }
                                                              }
                                                            }
                                                          }
                                                        }
                                                      }
                                                    }
                                                  }
                                                }
                                              }
