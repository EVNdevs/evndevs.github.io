{
  "format": "evn-blocks",
  "version": 2,
  "title": "Distance sensor: every block",
  "needs": "the distance sensor on I2C port 1, and a hand or a box to move in front of it",
  "description": "Every distance sensor block once: the distance in mm under each of the four settings (normal, long range, fast, accurate), then back to normal. Move your hand or a box in front of the sensor to see the numbers change; None means nothing is in range.",
  "workspace": {
    "blocks": {
      "languageVersion": 0,
      "blocks": [
        {
          "type": "evn_setup_start",
          "x": 30,
          "y": 30,
          "next": {
            "block": {
              "type": "evn_distance_setup",
              "fields": {
                "PORT": "1"
              }
            }
          }
        },
